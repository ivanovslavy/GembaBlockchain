diff --git a/mempool/recheck_pool.go b/mempool/recheck_pool.go
index 5a38319..3093c50 100644
--- a/mempool/recheck_pool.go
+++ b/mempool/recheck_pool.go
@@ -210,6 +210,34 @@ func (m *RecheckMempool) Insert(_ context.Context, tx sdk.Tx) (err error) {
 		ctx, write = m.rechecker.GetContext()
 	}
 
+	// GEMBA PATCH (2026-10-03): never judge a new transaction against a STALE context. The
+	// rechecker's ctx is a long-lived cache that this function writes back into (see write()
+	// below), and it only rolls over when doRecheck calls rechecker.Update on a new head — a
+	// path that logs and RETURNS SILENTLY when GetLatestContext fails. Once it stops, every
+	// later CheckTx is evaluated against the block time and the accumulated ante writes of the
+	// moment it froze, with nothing in the logs to say so.
+	//
+	// That locked a validator out of the x/valgate §6 daily bond cap for thirteen days: its own
+	// node kept answering "50 GMB already added today" with the day frozen at its last
+	// successful bond, so no amount — not even 1 agmb — could bond, and because the counter only
+	// advances on a SUCCESSFUL bond it could never roll over either. Every other node accepted
+	// the very same signed transaction. A restart was the only cure.
+	//
+	// So: compare the cached context against the chain head and refresh rather than trust it.
+	// On a healthy node this never fires; on a node whose refresh path has died it is the
+	// difference between a stale answer and a correct one.
+	if head := m.blockchain.CurrentBlock(); head != nil && head.Number != nil &&
+		ctx.BlockHeight() > 0 && ctx.BlockHeight() < head.Number.Int64()-1 {
+		m.logger.Error("rechecker context is stale — refreshing it before the insert",
+			"ctx_height", ctx.BlockHeight(), "chain_head", head.Number.Int64())
+		freshCtx, err := m.blockchain.GetLatestContext()
+		if err != nil {
+			return fmt.Errorf("refreshing a stale rechecker context: %w", err)
+		}
+		m.rechecker.Update(freshCtx, head)
+		ctx, write = m.rechecker.GetContext()
+	}
+
 	if _, err := m.rechecker.RecheckCosmos(ctx, tx); err != nil {
 		return fmt.Errorf("ante handler failed: %w", err)
 	}
